# copy this to .env and fill it in (cp .env.example .env). NEVER commit .env,
# it has the db password + jwt secret in it (.gitignore already skips it)

# atlas connection string, ask the db person for it (password filled in)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=BehaviorTracker

# port the API runs on
PORT=5000

# secret used to sign login tokens. make it long + random, you can generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# how long a login lasts before you have to log in again (ex: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# https: the let's encrypt cert on the droplet. leave both blank to run plain http on your laptop
SSL_KEY_PATH=/etc/letsencrypt/live/mernbehaviortracker.xyz/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/mernbehaviortracker.xyz/fullchain.pem

# --- email (verification + password reset) ---------------------------------
# leave SMTP_HOST blank and emails just get printed to the server log instead of sent.
# any SMTP service works (SendGrid, Brevo, Mailgun, a gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Behavior Tracker <no-reply@mernbehaviortracker.xyz>

# address of our react site. email links go to $APP_URL/verify-email?token=...
# and $APP_URL/reset-password?token=... (front end needs to make those 2 pages).
# leave blank and the verify link just goes straight to the API instead
APP_URL=

# true = users have to verify their email before they're allowed to log in
REQUIRE_EMAIL_VERIFICATION=false
